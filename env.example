# Copiá este archivo como `.env.local` y completá los valores.
# `.env.local` NO se sube al repositorio (está en .gitignore).

# 1. Creá una cuenta gratis en https://resend.com
# 2. Generá una API key en https://resend.com/api-keys y pegala acá:
RESEND_API_KEY=

# 3. Tu correo personal, el que va a recibir los registros:
REGISTRO_EMAIL_TO=

# 4. Opcional. Por defecto se envía desde "onboarding@resend.dev",
#    que solo puede enviar a la dirección con la que te registraste en Resend.
#    Si verificás un dominio propio, podés cambiarlo acá:
# RESEND_FROM=Gollo Registros <registros@tudominio.com>
